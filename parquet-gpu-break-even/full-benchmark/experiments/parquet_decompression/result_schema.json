{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPU Lab Parquet Decompression Result",
  "type": "object",
  "required": [
    "cache_state",
    "dataset",
    "experiment",
    "git_commit",
    "host",
    "policy",
    "run_id",
    "schema_version",
    "software",
    "trials"
  ],
  "properties": {
    "experiment": {"const": "parquet-decompression"},
    "schema_version": {"const": 1},
    "cache_state": {"const": "warm-os-cache"},
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "correct",
          "elapsed_seconds",
          "engine",
          "order",
          "phase",
          "repetition",
          "throughput_mib_s"
        ]
      }
    }
  }
}
